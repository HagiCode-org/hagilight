---
import Footer from '@hagicode/hagilight/Footer';
import SEOHead from '@hagicode/hagilight/SEOHead';
import PromotoBanner from '@hagicode/hagilight-core/PromotoBanner';
import logo from '@hagicode/hagilight-core/logo.png';
import favicon from '@hagicode/hagilight-core/favicon.ico';

interface Feature {
  id: string;
  title: string;
  kind: string;
  summary: string;
  evidence: string;
  example: string;
}

interface FeatureSection {
  id: string;
  title: string;
  description: string;
  features: Feature[];
}

interface Props {
  locale: string;
  languageLabel: string;
  title: string;
  description: string;
  exploreLabel: string;
  feedLabel: string;
  indexTitle: string;
  liveFooterTitle: string;
  liveFooterDescription: string;
  resolverLabel: string;
  feedNavLabel: string;
  fallbackNotice: string;
  sections: FeatureSection[];
  fallback: {
    id: string;
    title: string;
    description: string;
    ctaLabel: string;
    link: string;
  };
}

const {
  locale,
  languageLabel,
  title,
  description,
  exploreLabel,
  feedLabel,
  indexTitle,
  liveFooterTitle,
  liveFooterDescription,
  resolverLabel,
  feedNavLabel,
  fallbackNotice,
  sections,
  fallback,
} = Astro.props;
const isChinese = locale === 'zh-CN';
const site = Astro.site?.href;
if (!site) throw new Error('The Hagilight core demo requires an absolute Astro site URL.');

const basePath = import.meta.env.BASE_URL;
const pageUrl = new URL(Astro.url.pathname, site).href;
const feedPath = `${basePath}rss.xml`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': site,
    name: 'Hagilight',
    url: site,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: pageUrl,
    isPartOf: { '@id': site },
  },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <title>{title} — Hagilight</title>
    <link rel="icon" href={favicon} type="image/x-icon" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Hagilight core package showcase"
      href={feedPath}
    />
    <SEOHead
      site={site}
      page={{ url: pageUrl, title, description }}
      structuredData={structuredData}
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={isChinese ? `${basePath}zh-CN/` : basePath} aria-label="Hagilight">
        <img src={logo.src} alt="" width="34" height="34" />
        <span>Hagilight</span>
        <span class="package-name">@hagicode/hagilight</span>
      </a>
      <nav aria-label={languageLabel} class="header-actions">
        <a class="feed-link" href={feedPath}>{feedLabel}</a>
        <div class="language-nav">
          <a href={basePath} lang="en-US" aria-current={locale === 'en-US' ? 'page' : undefined}>EN</a>
          <a
            href={`${basePath}zh-CN/`}
            lang="zh-CN"
            aria-current={isChinese ? 'page' : undefined}
          >简中</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="page-title">
        <p class="eyebrow">@hagicode/hagilight <span>·</span> {isChinese ? '独立 Astro 示例' : 'Standalone Astro example'}</p>
        <h1 id="page-title">{title}</h1>
        <p class="hero-description">{description}</p>
        <a class="jump-link" href="#feature-index">{exploreLabel}</a>
      </section>

      <nav id="feature-index" class="feature-index" aria-labelledby="index-title">
        <h2 id="index-title">{indexTitle}</h2>
        <ul>
          {sections.flatMap((section) => section.features).map((feature) => (
            <li><a href={`#${feature.id}`}>{feature.title}</a></li>
          ))}
        </ul>
      </nav>

      {sections.map((section) => (
        <section id={section.id} class="feature-section" aria-labelledby={`${section.id}-title`}>
          <div class="section-heading">
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            <p>{section.description}</p>
          </div>
          <div class="feature-grid">
            {section.features.map((feature) => (
              <article id={feature.id} class="feature-card">
                <p class="feature-kind">{feature.kind}</p>
                <h3>{feature.title}</h3>
                <p>{feature.summary}</p>
                <p class="evidence"><strong>{isChinese ? '在哪里查看：' : 'Evidence: '}</strong>{feature.evidence}</p>
                <pre><code>{feature.example}</code></pre>
              </article>
            ))}
          </div>
        </section>
      ))}

      <section id="live-footer-example" class="live-examples" aria-labelledby="live-footer-title">
        <div class="section-heading">
          <h2 id="live-footer-title">{liveFooterTitle}</h2>
          <p>{liveFooterDescription}</p>
        </div>
        <nav class="resolver-example" aria-label={feedNavLabel}>
          <span>{resolverLabel}</span>
          <a href={feedPath}>{feedLabel}</a>
        </nav>
      </section>

      <section class="promotion-note" aria-label={isChinese ? '推广横幅示例' : 'Promotion banner example'}>
        <p>{fallbackNotice}</p>
        <PromotoBanner locale={locale} fallback={fallback} />
      </section>
    </main>

    <div id="footer-preview">
      <Footer locale={locale} />
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #183b35;
    background: #f5f3ec;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    margin: 0;
    line-height: 1.6;
  }

  ::selection {
    color: #183b35;
    background: #d4ed73;
  }

  :focus-visible {
    outline: 2px solid #526f2a;
    outline-offset: 4px;
  }

  a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .site-header,
  main,
  #footer-preview {
    width: min(100% - 3rem, 76rem);
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid #d9d8cf;
  }

  .brand,
  .header-actions,
  .language-nav {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 0.7rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand img {
    display: block;
  }

  .package-name {
    margin-left: 0.2rem;
    color: #53675d;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 450;
  }

  .header-actions {
    gap: 1rem;
  }

  .feed-link,
  .language-nav a {
    color: #415a52;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .language-nav {
    gap: 0.3rem;
  }

  .language-nav a {
    min-width: 2.75rem;
    padding: 0.35rem 0.55rem;
    border-radius: 0.25rem;
    text-align: center;
  }

  .language-nav a[aria-current="page"] {
    color: #173b34;
    background: #e5e9d8;
    font-weight: 700;
  }

  .hero {
    max-width: 56rem;
    padding-block: clamp(3.5rem, 9vw, 7rem) 3.5rem;
  }

  .eyebrow,
  .feature-kind {
    margin: 0 0 0.7rem;
    color: #526b43;
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow span {
    padding-inline: 0.25rem;
  }

  .hero h1 {
    max-width: 17ch;
    margin: 0;
    color: #183b35;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.03;
    text-wrap: balance;
  }

  .hero-description {
    max-width: 62ch;
    margin: 1.25rem 0 0;
    color: #415a52;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
  }

  .jump-link {
    display: inline-flex;
    margin-top: 1.4rem;
    color: #285447;
    font-weight: 700;
  }

  .feature-index,
  .feature-section,
  .live-examples {
    border-top: 1px solid #d9d8cf;
    padding-block: 1.5rem;
  }

  .feature-index h2 {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
  }

  .feature-index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature-index a {
    display: inline-block;
    padding: 0.35rem 0.7rem;
    border: 1px solid #cbd1c4;
    border-radius: 999px;
    color: #285447;
    font-size: 0.83rem;
    text-decoration: none;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
  }

  .section-heading > p {
    max-width: 56ch;
    margin: 0;
    color: #53675d;
    font-size: 0.88rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .feature-card {
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid #d9d8cf;
    border-radius: 0.4rem;
    background: #fbfaf6;
    scroll-margin-top: 1rem;
  }

  .feature-card h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .feature-card > p:not(.feature-kind) {
    margin: 0.6rem 0 0;
    color: #415a52;
    font-size: 0.88rem;
  }

  .feature-card .evidence {
    color: #53675d;
  }

  .feature-card pre {
    overflow-x: auto;
    margin: 1rem 0 0;
    padding: 0.85rem;
    border-radius: 0.25rem;
    color: #f4f2e9;
    background: #183b35;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    line-height: 1.65;
    tab-size: 2;
  }

  .feature-card code {
    white-space: pre;
  }

  .live-examples {
    margin-top: 1rem;
  }

  .resolver-example {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    padding: 1rem;
    border-left: 3px solid #78904f;
    background: #e9eadf;
    font-size: 0.9rem;
  }

  .resolver-example span {
    color: #53675d;
  }

  .promotion-note {
    min-height: 3rem;
    color: #53675d;
    font-size: 0.8rem;
  }

  .promotion-note > p {
    max-width: 75ch;
  }

  #footer-preview {
    --hagilight-footer-border: #d9d8cf;
    padding-bottom: 1rem;
    scroll-margin-top: 1rem;
  }

  @media (max-width: 52rem) {
    .section-heading {
      display: block;
    }

    .section-heading > p {
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 42rem) {
    .site-header,
    main,
    #footer-preview {
      width: min(100% - 2rem, 76rem);
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }

    .header-actions {
      gap: 0.35rem;
    }

    .feed-link {
      padding-inline: 0.25rem;
      font-size: 0.78rem;
    }

    .package-name {
      display: none;
    }
  }

  @media (max-width: 24rem) {
    .site-header {
      align-items: flex-start;
    }

    .header-actions {
      align-items: flex-end;
      flex-direction: column-reverse;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :root {
      scroll-behavior: auto;
    }
  }
</style>
