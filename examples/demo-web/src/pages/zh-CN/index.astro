---
import DemoLayout from '../../layouts/DemoLayout.astro';
import Content from '../../snippets/content-images.zh-CN.md';

const sections = [
  {
    id: 'live-examples',
    title: '本页中的实时示例',
    description: '以下展示的是实际加载的包组件，而不是仿制的静态界面。',
    features: [
      {
        id: 'root-transit',
        title: '根路径中转页',
        kind: '可选页面 · 内置样式和动画',
        summary: '根路径通过 @hagicode/hagilight-core/RootTransit 展示中转动画，然后进入英文页面。组件包含默认样式、路由光束、静态继续链接和自动导航；转场时还会随机显示一张 img-gen 启动图（@hagicode/hagilight-core/splash-images 提供图片路径，splash={false} 可关闭）。出发看板按页面语言滚过 HagiCode 生态站点，并停在当前站点（@hagicode/hagilight-core/root-transit-board 生成各行，board={false} 可隐藏）。@hagicode/hagilight-core/root-transit 提供经过测试的 URL 和生命周期辅助函数。',
        evidence: '访问根路径查看中转效果，也可以立即点击继续链接；中文深层链接仍直接打开本页。',
        example: "import RootTransit from '@hagicode/hagilight-core/RootTransit';\n\n<RootTransit destination=\"/en-US/\" siteName=\"Hagilight\" />",
      },
      {
        id: 'footer',
        title: '本地化页脚',
        kind: '实时组件',
        summary: '功能包页脚以产品介绍开场（标题、简介、下载与产品文档按钮，以及智能、高效、有趣三个特点），再解析本地化链接，并附加 @hagicode/hagilight 自身的精确构建版本。介绍文案来自 @hagicode/hagilight-core/footer-brand，由 @hagicode/hagilight-core/FooterBrand 渲染。',
        evidence: '滚动到页面底部：页脚进入视野时，标题逐行显现、三条特点分隔线依次画出，其下是真实链接和包版本标识。',
        example: "import Footer from '@hagicode/hagilight/Footer';\nimport CoreFooter from '@hagicode/hagilight-core/Footer';\n\n<Footer locale=\"zh-CN\" links={{ rssFeedUrl: '/rss.xml' }} />\n\n{/* CoreFooter 仍可单独使用，且不会显示功能包标识。 */}\n<CoreFooter locale=\"zh-CN\" />\n\nimport FooterBrand from '@hagicode/hagilight-core/FooterBrand';\nimport { resolveFooterBrand } from '@hagicode/hagilight-core/footer-brand';\n\nconst { headline, pillars } = resolveFooterBrand('zh-CN');",
      },
      {
        id: 'footer-avatar',
        title: '页脚头像',
        kind: '实时组件',
        summary: "页脚以一个小巧的装饰性 HagiCode 头像开场，以 AVIF 与 WebP 两个文件提供，128 px 源图用于 64 px 的显示框。@hagicode/hagilight-core/footer-avatar 解析 avatar 与 randomAvatar 选项，@hagicode/hagilight-core/random-image 每次页面浏览从 cat-head-gallery 池中随机选择一幅，预加载后仅在三秒内加载成功时替换。",
        evidence: "刷新页面可看到不同的头像。禁用脚本或屏蔽 img-gen 时保留内置默认图，布局不会移动。",
        example: "import avatarAvif from '@hagicode/hagilight-core/assets/footer/avatar.avif';\nimport avatarWebp from '@hagicode/hagilight-core/assets/footer/avatar.webp';\nimport avatarManifest from '@hagicode/hagilight-core/assets/footer/manifest.json';\nimport { resolveFooterAvatarOptions } from '@hagicode/hagilight-core/footer-avatar';\nimport { mountRandomImages } from '@hagicode/hagilight-core/random-image';\n\n{/* avatar 与 randomAvatar 默认为 true；设为 false 时分别移除头像元素或随机池。 */}\n<Footer avatar={true} randomAvatar={false} />",
      },
      {
        id: 'copyright',
        title: '版权信息',
        kind: '页脚内实时呈现 · 可单独导入',
        summary: 'Footer 默认组合 Copyright，也可以在其他位置单独渲染。',
        evidence: '页脚展示当前年份和 HagiCode 名称。',
        example: "import Copyright from '@hagicode/hagilight-core/Copyright';\n\n<Copyright name=\"HagiCode\" />",
      },
      {
        id: 'build-info',
        title: '构建信息',
        kind: '页脚内实时呈现 · 构建时解析',
        summary: '页脚末尾显示分支、提交和构建时间。@hagicode/hagilight-core/build-info 在浏览器中格式化这些信息，@hagicode/hagilight-core/build-info-resolver 在构建时读取 Git 以及 HAGILIGHT_BUILD_BRANCH、HAGILIGHT_BUILD_COMMIT 覆盖值。',
        evidence: '页脚版权行显示本示例的分支、七位提交号以及 UTC 构建时间。',
        example: "import { buildInfoItems } from '@hagicode/hagilight-core/build-info';\nimport { resolveBuildInfo } from '@hagicode/hagilight-core/build-info-resolver';\n\nconst items = buildInfoItems(resolveBuildInfo({ root: process.cwd() }));",
      },
      {
        id: 'site-metadata',
        title: '站点元数据文件',
        kind: '构建产物 · schema 版本 1',
        summary: '构建会写入 .well-known/hagilight.metadata.json，包含站点标识、语言、构建信息、发现文件以及分析工具开关。@hagicode/hagilight-core/site-metadata 定义契约，@hagicode/hagilight-core/site-metadata-writer 在 Node 中写入文件，@hagicode/hagilight-core/site-metadata-ownership 决定由哪个集成写入。',
        evidence: '本演示构建包含 .well-known/hagilight.metadata.json，其 discovery 字段列出了构建实际生成的 llms.txt 和站点地图。',
        example: "import { buildSiteMetadata, serializeSiteMetadata } from '@hagicode/hagilight-core/site-metadata';\n\nconst json = serializeSiteMetadata(buildSiteMetadata({ generator, site, build, discovery, analytics }));",
      },
      {
        id: 'site-links',
        title: '共享站点链接',
        kind: '实时组合',
        summary: '布局将由站点提供的 RSS 地址传入链接解析器和 Footer。',
        evidence: '页眉和页脚中的 RSS 链接都会指向此示例的 feed。',
        example: "import { resolveSiteLinks } from '@hagicode/hagilight-core/links';\n\nconst links = resolveSiteLinks('zh-CN', {\n  rssFeedUrl: '/rss.xml',\n});",
      },
      {
        id: 'promotion',
        title: '推广横幅',
        kind: '实时组件 · 远程推广为可选',
        summary: 'PromotoBanner 优先展示符合条件的远程推广；没有可用推广时使用本地化后备内容。@hagicode/hagilight-core/promotions 提供带类型的推广加载器，@hagicode/hagilight-core/promoto-banner 提供与框架无关的自定义元素，Docusaurus 包会挂载它。',
        evidence: '本页挂载了该组件；后备按钮会跳转到页脚，组件进入页脚区域时会隐藏。',
        example: "import PromotoBanner from '@hagicode/hagilight-core/PromotoBanner';\n\n<PromotoBanner locale=\"zh-CN\" fallback={fallbackCard} />",
      },
      {
        id: 'logo',
        title: 'Logo 资源',
        kind: '实时资源',
        summary: '页面页眉直接导入并显示包中提供的 Logo 图片资源。',
        evidence: '请查看页面顶部的 Hagilight 标志。',
        example: "import logo from '@hagicode/hagilight-core/logo.png';\n\n<img src={logo.src} alt=\"Hagilight\" />",
      },
    ],
  },
  {
    id: 'head-and-build',
    title: '页面 head 与构建产物',
    description: '这些集成会生成元数据、浏览器图标或 feed，不会额外显示成页面组件。',
    features: [
      {
        id: 'seo-head',
        title: 'SEO head',
        kind: '真实文档 head',
        summary: 'SEOHead 为当前路由生成 canonical 地址，以及 Open Graph 和 Twitter 标题、描述元数据。',
        evidence: '检查本页文档 head 或查看源代码中的 canonical 和分享字段。',
        example: "import SEOHead from '@hagicode/hagilight/SEOHead';\n\nconst site = Astro.site.href;\nconst pageUrl = new URL(Astro.url.pathname, site).href;\n\n<SEOHead\n  site={site}\n  page={{ url: pageUrl, title, description }}\n  structuredData={pageStructuredData}\n/>",
      },
      {
        id: 'seo-tools',
        title: 'SEO 工具与 schema',
        kind: '构建时工具',
        summary: '工具函数可构造安全的 canonical 和 JSON-LD 数据；seoSchema 用于校验可选 frontmatter 字段；classifyOgImage 判断预览图格式是否可被爬虫读取。',
        evidence: '本页 head 中的 JSON-LD 脚本只包含示例站点和页面事实。',
        example: "import { buildBreadcrumbStructuredData } from '@hagicode/hagilight-core/seo';\nimport { seoSchema } from '@hagicode/hagilight-core/seo-schema';\nimport { classifyOgImage } from '@hagicode/hagilight-core/og-image';\n\nconst pageSeo = seoSchema.parse({ seo: { title, description } });\nconst imageFormat = classifyOgImage('/social/card.avif'); // 'convertible'",
      },
      {
        id: 'favicon',
        title: 'Favicon',
        kind: '浏览器标签页可见 · 构建集成',
        summary: 'Astro 集成会加入内置 favicon；包也导出 favicon.ico 静态资源，可复制到站点目录。',
        evidence: '查看浏览器标签页图标；集成会将 data URI 注入生成页面的 head。',
        example: "import { hagilightFavicon } from '@hagicode/hagilight/integration';\nimport { resolveFaviconHeadEntry } from '@hagicode/hagilight-core/favicon';\nimport favicon from '@hagicode/hagilight-core/favicon.ico';\n\nintegrations: [hagilightFavicon()]\n<link rel=\"icon\" href={favicon} type=\"image/x-icon\" />",
      },
      {
        id: 'rss',
        title: 'RSS feed',
        kind: '真实构建产物 · 多语言集成',
        summary: '集成根据站点提供的 feed 数据生成多语言路由；使用方仍可用 core 的 RSS renderer 自行维护路由，@hagicode/hagilight-core/rss-ownership 让同一项目中的 Starlight 插件接管路由。',
        evidence: '点击页眉或页脚中的 RSS 链接即可打开英文或当前语言 feed。',
        example: "import { hagilight, type RssFeedCallback } from '@hagicode/hagilight/integration';\n\nintegrations: [hagilight({ rss: { getFeed: './src/rss-feed.ts' } })]",
      },
    ],
  },
  {
    id: 'body-content',
    title: '正文内容',
    description: 'Markdown 图片在站点构建时统一处理，页面不会为它们添加运行时脚本。',
    features: [
      {
        id: 'content-images',
        title: '正文图片',
        kind: '构建时 Markdown 插件 · 使用 hagilight() 时自动启用',
        summary: '位于 picture 元素之外的 Markdown 与 MDX 正文图片会获得惰性与异步加载的默认值，以及 hagilight-content-image 类名；作者已设置的 loading 与 decoding 值会保留。',
        evidence: '下方示例来自一个 Markdown 文件，包含相对路径本地图片和站点根路径图片；它们的 img 元素都带有标记类名。',
        example: "import { rehypeContentImages } from '@hagicode/hagilight-core/content-images';\n\n// 使用 hagilight() 时自动启用；如需关闭，请传入 hagilight({ contentImages: false })",
      },
    ],
  },
  {
    id: 'shared-data',
    title: '共享数据',
    description: '打包在包内的数据与契约，其他站点无需保留自己的副本即可读取。',
    features: [
      {
        id: 'comparison-articles',
        title: '对比文章数据',
        kind: '打包数据 · 浏览器安全契约、Node 加载器与原始 JSON',
        summary: '对比文章随包一同发布。@hagicode/hagilight-core/comparison-articles 提供浏览器安全的契约，@hagicode/hagilight-core/comparison-articles-source 在 Node 中读取打包文件，@hagicode/hagilight-core/comparison-articles-data/*.json 则可把单篇文章作为原始 JSON 导入。',
        evidence: '本页不渲染这些数据；下方示例展示使用方如何读取它们。',
        example: "import { buildStructuredArticleRootManifest } from '@hagicode/hagilight-core/comparison-articles-source';\nimport { validateStructuredArticleDetail } from '@hagicode/hagilight-core/comparison-articles';\nimport claude from '@hagicode/hagilight-core/comparison-articles-data/en-US/claude-vs-hagicode.json' with { type: 'json' };\n\nconst manifest = await buildStructuredArticleRootManifest();\nconst article = validateStructuredArticleDetail(claude);",
      },
    ],
  },
  {
    id: 'optional-integrations',
    title: '可选集成',
    description: '本展示页在生产环境启用 PostHog；Google Analytics 与 51LA 保留为可选导入示例。',
    features: [
      {
        id: 'analytics',
        title: 'PostHog、Google Analytics 与 51LA',
        kind: '可选 · 仅生产环境加载脚本',
        summary: 'hagilight() 集成会自动注入 PostHog，使用内置项目 key，无需传参；Google Analytics 与 51LA 需要 ID。三个组件都只在生产构建中输出第三方跟踪脚本。GoogleAnalytics 还会把已标记链接的点击作为 link_click 或 download_click 事件上报；@hagicode/hagilight-core/analytics-events 提供带类型的标记构造函数。',
        evidence: 'PostHog 由集成注入每个页面的 head 一次，生产环境访问会向 HagiCode 的共享项目发送活动数据。',
        example: "// astro.config.mjs: hagilight() injects PostHog into every production head.\nhagilight({ analytics: { posthog: { enabled: false } } }); // opt out\n\n// Custom head only: render the shared component once when the integration is not the owner.\nimport PostHog from '@hagicode/hagilight-core/PostHog';\nimport { posthogInitScript } from '@hagicode/hagilight-core/posthog';\n\n<PostHog />\n\nimport GoogleAnalytics from '@hagicode/hagilight-core/GoogleAnalytics';\nimport Analytics51LA from '@hagicode/hagilight-core/Analytics51LA';\n\n{import.meta.env.PUBLIC_GA_ID && <GoogleAnalytics measurementId={import.meta.env.PUBLIC_GA_ID} />}\n{import.meta.env.PUBLIC_51LA_SITE_ID && <Analytics51LA siteId={import.meta.env.PUBLIC_51LA_SITE_ID} />}\n\nimport { gaEventAttributes } from '@hagicode/hagilight-core/analytics-events';\n\n<a href=\"/download\" {...gaEventAttributes({ category: 'download', label: 'customDownload', location: 'footer' })}>Download</a>",
      },
    ],
  },
];

const fallback = {
  id: 'demo-web-fallback-zh',
  title: '没有远程推广时也有可用示例',
  description: '没有符合条件的远程推广时，会显示这条本地示例。',
  ctaLabel: '查看页脚行为',
  link: '#footer-preview',
};
---

<DemoLayout
  locale="zh-CN"
  languageLabel="选择语言"
  title="探索 Hagilight core，无需 Starlight。"
  description="通过独立的 Astro 双语示例，了解 @hagicode/hagilight 提供的共享组件和构建集成。"
  exploreLabel="浏览功能"
  feedLabel="RSS feed"
  indexTitle="功能索引"
  liveFooterTitle="查看实际页脚"
  liveFooterDescription="这是包中的 Footer 组件，包含本地化共享链接和 Copyright。滚动到此处可查看推广横幅如何为页脚让出空间。"
  resolverLabel="由使用方解析的 feed 链接："
  feedNavLabel="由示例站点维护的 RSS feed"
  fallbackNotice="推广示例：符合条件的远程推广可能替代此本地后备内容。后备链接会跳转到页脚，以演示组件的可见性行为。"
  sections={sections}
  markdownSampleTitle="Markdown 正文图片"
  fallback={fallback}
>
  <Content slot="markdown-sample" />
</DemoLayout>
