---
import DemoLayout from '../../layouts/DemoLayout.astro';
import Content from '../../snippets/content-images.en-US.md';

const sections = [
  {
    id: 'live-examples',
    title: 'Live on this page',
    description: 'These are real package components, rendered here rather than recreated as mockups.',
    features: [
      {
        id: 'root-transit',
        title: 'Root transit',
        kind: 'Opt-in page · built-in presentation',
        summary: 'The root opens @hagicode/hagilight-core/RootTransit before forwarding here. Its styling, route sweep, static continuation link and navigation are bundled, and it shows one random image from the img-gen startup splash while it forwards (@hagicode/hagilight-core/splash-images holds the image paths; splash={false} opts out). A departures board scrolls through the HagiCode ecosystem sites in the page language and stops on this site (@hagicode/hagilight-core/root-transit-board builds its rows; board={false} hides it). @hagicode/hagilight-core/root-transit exposes the tested URL and lifecycle helpers.',
        evidence: 'Open the site root to see the transition, or follow its continuation link immediately.',
        example: "import RootTransit from '@hagicode/hagilight-core/RootTransit';\n\n<RootTransit destination=\"/en-US/\" siteName=\"Hagilight\" />",
      },
      {
        id: 'footer',
        title: 'Localized footer',
        kind: 'Live component',
        summary: 'The feature footer opens with a product statement (headline, summary, Download and Product Docs, and the smart, efficient and fun pillars), then resolves localized links and appends its exact build-time @hagicode/hagilight version. The statement comes from @hagicode/hagilight-core/footer-brand and renders through @hagicode/hagilight-core/FooterBrand.',
        evidence: 'Scroll to the bottom: the headline is uncovered and the pillar rules draw in as the footer arrives, above the real links and package attribution.',
        example: "import Footer from '@hagicode/hagilight/Footer';\nimport CoreFooter from '@hagicode/hagilight-core/Footer';\n\n<Footer locale=\"en-US\" links={{ rssFeedUrl: '/rss.xml' }} />\n\n{/* CoreFooter remains available without feature-package attribution. */}\n<CoreFooter locale=\"en-US\" />\n\nimport FooterBrand from '@hagicode/hagilight-core/FooterBrand';\nimport { resolveFooterBrand } from '@hagicode/hagilight-core/footer-brand';\n\nconst { headline, pillars } = resolveFooterBrand('en-US');",
      },
      {
        id: 'footer-avatar',
        title: 'Footer avatar',
        kind: 'Live component',
        summary: "The footer opens with a small decorative HagiCode avatar, shipped as an AVIF and WebP pair at 128 px for a 64 px box. @hagicode/hagilight-core/footer-avatar resolves the avatar and randomAvatar options, and @hagicode/hagilight-core/random-image picks one entry of the cat-head-gallery pool per page view, preloads it, and swaps it in only when it loads within three seconds.",
        evidence: "Reload the page to see a different avatar. With scripts disabled or img-gen blocked, the vendored default stays and the layout does not move.",
        example: "import avatarAvif from '@hagicode/hagilight-core/assets/footer/avatar.avif';\nimport avatarWebp from '@hagicode/hagilight-core/assets/footer/avatar.webp';\nimport avatarManifest from '@hagicode/hagilight-core/assets/footer/manifest.json';\nimport { resolveFooterAvatarOptions } from '@hagicode/hagilight-core/footer-avatar';\nimport { mountRandomImages } from '@hagicode/hagilight-core/random-image';\n\n{/* avatar and randomAvatar default to true; false removes the element or the random pool. */}\n<Footer avatar={true} randomAvatar={false} />",
      },
      {
        id: 'copyright',
        title: 'Copyright',
        kind: 'Live in footer · direct export',
        summary: 'Footer composes Copyright by default; sites can also render it independently.',
        evidence: 'The footer shows the current year and HagiCode name.',
        example: "import Copyright from '@hagicode/hagilight-core/Copyright';\n\n<Copyright name=\"HagiCode\" />",
      },
      {
        id: 'build-info',
        title: 'Build line',
        kind: 'Live in footer · build-time resolver',
        summary: 'The footer ends with Branch, Commit, and Built. @hagicode/hagilight-core/build-info formats them in the browser, while @hagicode/hagilight-core/build-info-resolver reads Git and the HAGILIGHT_BUILD_BRANCH and HAGILIGHT_BUILD_COMMIT overrides at build time.',
        evidence: 'The footer copyright line shows this demo’s branch, its seven-character commit, and the UTC build time.',
        example: "import { buildInfoItems } from '@hagicode/hagilight-core/build-info';\nimport { resolveBuildInfo } from '@hagicode/hagilight-core/build-info-resolver';\n\nconst items = buildInfoItems(resolveBuildInfo({ root: process.cwd() }));",
      },
      {
        id: 'site-metadata',
        title: 'Site metadata file',
        kind: 'Build output · schema version 1',
        summary: 'The build writes .well-known/hagilight.metadata.json with site identity, locales, build facts, discovery artifacts, and analytics on/off flags. @hagicode/hagilight-core/site-metadata holds the contract, @hagicode/hagilight-core/site-metadata-writer writes it in Node, and @hagicode/hagilight-core/site-metadata-ownership decides which integration writes it.',
        evidence: 'This demo build contains .well-known/hagilight.metadata.json, and its discovery block lists the llms.txt and sitemap that the build produced.',
        example: "import { buildSiteMetadata, serializeSiteMetadata } from '@hagicode/hagilight-core/site-metadata';\n\nconst json = serializeSiteMetadata(buildSiteMetadata({ generator, site, build, discovery, analytics }));",
      },
      {
        id: 'site-links',
        title: 'Shared site links',
        kind: 'Live composition',
        summary: 'The layout passes a consumer-owned RSS destination to the resolver and the Footer.',
        evidence: 'The RSS link above and in the footer resolves to this demo’s feed.',
        example: "import { resolveSiteLinks } from '@hagicode/hagilight-core/links';\n\nconst links = resolveSiteLinks('en-US', {\n  rssFeedUrl: '/rss.xml',\n});",
      },
      {
        id: 'promotion',
        title: 'Promotion banner',
        kind: 'Live component · remote campaign optional',
        summary: 'PromotoBanner prefers an eligible remote campaign and uses the localized fallback when none is available; @hagicode/hagilight-core/promotions exposes the typed campaign loader, and @hagicode/hagilight-core/promoto-banner exposes the framework-neutral custom element that the Docusaurus package mounts.',
        evidence: 'The banner is mounted on this page; its fallback CTA jumps to the footer, where the component hides itself.',
        example: "import PromotoBanner from '@hagicode/hagilight-core/PromotoBanner';\n\n<PromotoBanner locale=\"en-US\" fallback={fallbackCard} />",
      },
      {
        id: 'logo',
        title: 'Logo asset',
        kind: 'Live asset',
        summary: 'The package logo is displayed in the site header as an imported image asset.',
        evidence: 'See the Hagilight mark at the top of this page.',
        example: "import logo from '@hagicode/hagilight-core/logo.png';\n\n<img src={logo.src} alt=\"Hagilight\" />",
      },
    ],
  },
  {
    id: 'head-and-build',
    title: 'Page head and build outputs',
    description: 'These integrations produce metadata, a browser icon, or a feed—not additional page widgets.',
    features: [
      {
        id: 'seo-head',
        title: 'SEO head',
        kind: 'Live in document head',
        summary: 'SEOHead emits a route-specific canonical URL plus Open Graph and Twitter title/description metadata.',
        evidence: 'Inspect this page’s document head and view-source for its canonical and sharing fields.',
        example: "import SEOHead from '@hagicode/hagilight/SEOHead';\n\nconst site = Astro.site.href;\nconst pageUrl = new URL(Astro.url.pathname, site).href;\n\n<SEOHead\n  site={site}\n  page={{ url: pageUrl, title, description }}\n  structuredData={pageStructuredData}\n/>",
      },
      {
        id: 'seo-tools',
        title: 'SEO helpers and schema',
        kind: 'Build-time tools',
        summary: 'Utilities build safe canonical and JSON-LD data; seoSchema validates optional frontmatter fields.',
        evidence: 'The JSON-LD scripts in this page head contain only the demo site and page facts.',
        example: "import { buildBreadcrumbStructuredData } from '@hagicode/hagilight-core/seo';\nimport { seoSchema } from '@hagicode/hagilight-core/seo-schema';\n\nconst pageSeo = seoSchema.parse({ seo: { title, description } });",
      },
      {
        id: 'favicon',
        title: 'Favicon',
        kind: 'Live in browser tab · build integration',
        summary: 'The Astro integration adds the bundled favicon; the package also exports the favicon.ico asset for static copying.',
        evidence: 'Look at the browser tab icon. The integration injects its data URI into the generated page head.',
        example: "import { hagilightFavicon } from '@hagicode/hagilight/integration';\nimport { resolveFaviconHeadEntry } from '@hagicode/hagilight-core/favicon';\nimport favicon from '@hagicode/hagilight-core/favicon.ico';\n\nintegrations: [hagilightFavicon()]\n<link rel=\"icon\" href={favicon} type=\"image/x-icon\" />",
      },
      {
        id: 'rss',
        title: 'RSS feed',
        kind: 'Live build output · localized integration',
        summary: 'The integration generates locale-specific routes from site-owned feed data; the core RSS renderer remains available for consumer-owned routes, and @hagicode/hagilight-core/rss-ownership lets a Starlight plugin in the same project own the routes.',
        evidence: 'Use the RSS link in the header or footer to open the English or current-language feed.',
        example: "import { hagilight, type RssFeedCallback } from '@hagicode/hagilight/integration';\n\nintegrations: [hagilight({ rss: { getFeed: './src/rss-feed.ts' } })]",
      },
    ],
  },
  {
    id: 'body-content',
    title: 'Body content',
    description: 'Markdown images are normalized while the site builds; the page adds no runtime script for them.',
    features: [
      {
        id: 'content-images',
        title: 'Content images',
        kind: 'Build-time Markdown plugin · automatic with hagilight()',
        summary: 'Markdown and MDX body images outside picture elements get lazy and async loading defaults plus the hagilight-content-image class. Author-set loading and decoding values are kept.',
        evidence: 'The sample below comes from a Markdown file with a relative local image and a site-root image; their img elements carry the marker class.',
        example: "import { rehypeContentImages } from '@hagicode/hagilight-core/content-images';\n\n// Automatic with hagilight(); opt out with hagilight({ contentImages: false })",
      },
    ],
  },
  {
    id: 'shared-data',
    title: 'Shared data',
    description: 'Packaged data and contracts that other sites can read without keeping their own copy.',
    features: [
      {
        id: 'comparison-articles',
        title: 'Comparison article data',
        kind: 'Packaged data · browser-safe contract, Node loaders and raw JSON',
        summary: 'The comparison articles ship inside the package. @hagicode/hagilight-core/comparison-articles holds the browser-safe contract, @hagicode/hagilight-core/comparison-articles-source loads the packaged files in Node, and @hagicode/hagilight-core/comparison-articles-data/*.json imports one article as raw JSON.',
        evidence: 'The data is not rendered on this page; the example shows how a consumer reads it.',
        example: "import { buildStructuredArticleRootManifest } from '@hagicode/hagilight-core/comparison-articles-source';\nimport { validateStructuredArticleDetail } from '@hagicode/hagilight-core/comparison-articles';\nimport claude from '@hagicode/hagilight-core/comparison-articles-data/en-US/claude-vs-hagicode.json' with { type: 'json' };\n\nconst manifest = await buildStructuredArticleRootManifest();\nconst article = validateStructuredArticleDetail(claude);",
      },
    ],
  },
  {
    id: 'optional-integrations',
    title: 'Optional integrations',
    description: 'PostHog runs in production on this showcase. Google Analytics and 51LA remain optional examples.',
    features: [
      {
        id: 'analytics',
        title: 'PostHog, Google Analytics and 51LA',
        kind: 'Optional · production-only scripts',
        summary: 'The hagilight() integration injects PostHog with the supplied project key, no props needed; Google Analytics and 51LA require an ID. All three emit third-party tracking scripts only in production builds. GoogleAnalytics also reports clicks on tagged links as link_click or download_click events; @hagicode/hagilight-core/analytics-events exposes the typed tag builders.',
        evidence: 'PostHog is injected once into every page head by the integration. Production visits send activity to the shared HagiCode project.',
        example: "// astro.config.mjs: hagilight() injects PostHog into every production head.\nhagilight({ analytics: { posthog: { enabled: false } } }); // opt out\n\n// Custom head only: render the shared component once when the integration is not the owner.\nimport PostHog from '@hagicode/hagilight-core/PostHog';\nimport { posthogInitScript } from '@hagicode/hagilight-core/posthog';\n\n<PostHog />\n\nimport GoogleAnalytics from '@hagicode/hagilight-core/GoogleAnalytics';\nimport Analytics51LA from '@hagicode/hagilight-core/Analytics51LA';\n\n{import.meta.env.PUBLIC_GA_ID && <GoogleAnalytics measurementId={import.meta.env.PUBLIC_GA_ID} />}\n{import.meta.env.PUBLIC_51LA_SITE_ID && <Analytics51LA siteId={import.meta.env.PUBLIC_51LA_SITE_ID} />}\n\nimport { gaEventAttributes } from '@hagicode/hagilight-core/analytics-events';\n\n<a href=\"/download\" {...gaEventAttributes({ category: 'download', label: 'customDownload', location: 'footer' })}>Download</a>",
      },
    ],
  },
];

const fallback = {
  id: 'demo-web-fallback-en',
  title: 'A useful link, even without a campaign',
  description: 'This local example appears when no eligible remote promotion is available.',
  ctaLabel: 'See the footer behavior',
  link: '#footer-preview',
};
---

<DemoLayout
  locale="en-US"
  languageLabel="Language"
  title="Explore Hagilight core, without Starlight."
  description="A bilingual, standalone Astro tour of the shared components and build integrations in @hagicode/hagilight."
  exploreLabel="Explore the features"
  feedLabel="RSS feed"
  indexTitle="Feature index"
  liveFooterTitle="Try the rendered footer"
  liveFooterDescription="This is the package Footer component, including localized shared links and Copyright. Scroll here to see the promotion banner yield space to the footer."
  resolverLabel="Consumer-resolved feed link:"
  feedNavLabel="Consumer-owned RSS feed"
  fallbackNotice="Promotion example: eligible remote campaigns may replace this local fallback. It links to the footer to demonstrate the component’s visibility behavior."
  sections={sections}
  markdownSampleTitle="Markdown body images"
  fallback={fallback}
>
  <Content slot="markdown-sample" />
</DemoLayout>
