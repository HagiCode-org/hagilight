{
  "name": "hagilight-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -b",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -b && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p tsconfig.routes.json && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p test/types/tsconfig.json",
    "pretest": "pnpm run build",
    "test": "node --test test/*.test.mjs",
    "test:viewport": "node test/viewport-regression.mjs && node test/root-transit-browser.mjs && node test/mermaid-browser.mjs",
    "build:example": "node scripts/build-example.mjs",
    "build:starlight-example": "pnpm run build && pnpm --filter hagilight-example run build",
    "build:core-footer-example": "pnpm run build && pnpm --filter hagilight-core-footer-example run build",
    "prebuild:docusaurus-example": "pnpm run build",
    "build:docusaurus-example": "pnpm --filter hagilight-docusaurus-example run build",
    "pack:check": "node scripts/verify-pack.mjs",
    "integration:installed": "node scripts/integration-installed.mjs",
    "check:registry": "node scripts/check-registry-neutrality.mjs",
    "test:registry": "node --test scripts/check-registry-neutrality.node-test.mjs"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.4",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@hagicode/hagilight": "0.1.0",
    "@hagicode/hagilight-core": "0.1.0",
    "@hagicode/hagilight-docusaurus": "0.1.0",
    "@hagicode/hagilight-mermaid": "0.1.0",
    "@hagicode/hagilight-starlight": "0.1.0",
    "@types/node": "^24.19.0",
    "astro": "^7.3.5",
    "mermaid": "11.16.1",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "version": "1.0.0",
  "description": "[![npm @hagicode/hagilight](https://img.shields.io/npm/v/@hagicode/hagilight?label=@hagicode/hagilight&logo=npm)](https://www.npmjs.com/package/@hagicode/hagilight) [![npm @hagicode/hagilight-core](https://img.shields.io/npm/v/@hagicode/hagilight-core?label=@hagicode/hagilight-core&logo=npm)](https://www.npmjs.com/package/@hagicode/hagilight-core) [![npm @hagicode/hagilight-starlight](https://img.shields.io/npm/v/@hagicode/hagilight-starlight?label=@hagicode/hagilight-starlight&logo=npm)](https://www.npmjs.com/package/@hagicode/hagilight-starlight)",
  "main": "index.js",
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HagiCode-org/hagilight.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/HagiCode-org/hagilight/issues"
  },
  "homepage": "https://github.com/HagiCode-org/hagilight#readme",
  "packageManager": "pnpm@12.16.1"
}
