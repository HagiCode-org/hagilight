---
import type { PromotionCard } from './promotions';

interface Props {
  fallback?: PromotionCard;
  locale?: string;
}

const { fallback, locale = Astro.currentLocale ?? 'en' } = Astro.props;
---

<hagilight-promoto-banner
  class="hagilight-promoto"
  data-locale={locale}
  data-fallback={fallback ? JSON.stringify(fallback) : undefined}
  hidden
>
  <section class="hagilight-promoto__shell" data-promoto-shell hidden aria-label="Featured promotion">
    <button
      type="button"
      class="hagilight-promoto__dismiss"
      data-promoto-dismiss
      aria-label="Dismiss promotion"
    >&times;</button>
    <div class="hagilight-promoto__viewport">
      <div class="hagilight-promoto__track" data-promoto-track></div>
    </div>
    <nav class="hagilight-promoto__controls" data-promoto-controls aria-label="Promotion controls" hidden>
      <button type="button" class="hagilight-promoto__control" data-promoto-previous aria-label="Previous promotion">‹</button>
      <span class="hagilight-promoto__count" data-promoto-count aria-label="Promotion progress"></span>
      <button type="button" class="hagilight-promoto__control" data-promoto-next aria-label="Next promotion">›</button>
      <button type="button" class="hagilight-promoto__control" data-promoto-pause aria-pressed="false">Pause</button>
    </nav>
    <span class="hagilight-promoto__status" data-promoto-status aria-live="polite"></span>
  </section>
</hagilight-promoto-banner>

<script>
  import { definePromotoBannerElement } from './promoto-banner';

  definePromotoBannerElement();
</script>

<style is:global>
  .hagilight-promoto {
    display: block;
  }

  .hagilight-promoto[hidden],
  .hagilight-promoto__shell[hidden],
  .hagilight-promoto__controls[hidden] {
    display: none !important;
  }

  .hagilight-promoto__shell {
    position: fixed;
    z-index: 40;
    inset-inline: 0;
    bottom: max(1rem, env(safe-area-inset-bottom));
    width: min(72rem, calc(100vw - 1rem));
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent, #2563eb) 24%, var(--sl-color-gray-5, #cbd5e1));
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--sl-color-bg, #fff) 96%, var(--sl-color-accent-low, #dbeafe) 4%);
    box-shadow: 0 18px 48px color-mix(in srgb, var(--sl-color-black, #000) 16%, transparent);
    color: var(--sl-color-text, #1f2937);
    opacity: 1;
    visibility: visible;
    transition: opacity 0.24s ease, visibility 0s linear;
  }

  .hagilight-promoto[data-state='footer-hidden'] .hagilight-promoto__shell {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.24s ease, visibility 0s linear 0.24s;
  }

  .hagilight-promoto__viewport {
    overflow: hidden;
  }

  .hagilight-promoto__track {
    display: flex;
    align-items: stretch;
    width: 100%;
    transition: transform 0.34s ease;
  }

  .hagilight-promoto__slide {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    min-width: 100%;
    padding: 1.25rem 4rem 1.25rem 1.25rem;
  }

  .hagilight-promoto__slide[aria-hidden='true'] {
    pointer-events: none;
  }

  .hagilight-promoto__copy {
    display: grid;
    grid-template-columns: minmax(12rem, 0.8fr) minmax(16rem, 1.2fr);
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .hagilight-promoto__title,
  .hagilight-promoto__description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--sl-color-text-high, #111827);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .hagilight-promoto__description {
    color: var(--sl-color-text, #1f2937);
  }

  .hagilight-promoto__image {
    display: block;
    width: clamp(4.5rem, 8vw, 6.25rem);
    aspect-ratio: 1;
    border-radius: 0.8rem;
    object-fit: cover;
  }

  .hagilight-promoto__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 7.5rem;
    min-height: 2.6rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent-high, #1d4ed8) 30%, transparent);
    border-radius: 999px;
    background: var(--sl-color-accent, #2563eb);
    color: #fff;
    font-size: var(--sl-text-xs);
    font-weight: 700;
    padding-inline: 1rem;
    text-align: center;
    text-decoration: none;
  }

  .hagilight-promoto__cta:hover,
  .hagilight-promoto__cta:focus-visible {
    background: var(--sl-color-accent-high, #1d4ed8);
  }

  .hagilight-promoto__dismiss,
  .hagilight-promoto__control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent-high, #1d4ed8) 20%, var(--sl-color-gray-5, #cbd5e1));
    border-radius: 999px;
    background: var(--sl-color-bg-nav, #f8fafc);
    color: var(--sl-color-text-high, #111827);
    cursor: pointer;
  }

  .hagilight-promoto__dismiss {
    position: absolute;
    z-index: 1;
    inset-block-start: 0.6rem;
    inset-inline-end: 0.6rem;
  }

  .hagilight-promoto__controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0 1.25rem 1rem;
  }

  .hagilight-promoto__count {
    min-width: 3.5rem;
    text-align: center;
    font-size: var(--sl-text-xs);
    font-variant-numeric: tabular-nums;
  }

  .hagilight-promoto__control:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .hagilight-promoto__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .hagilight-promoto__dismiss:focus-visible,
  .hagilight-promoto__control:focus-visible,
  .hagilight-promoto__cta:focus-visible {
    outline: 3px solid var(--sl-color-accent-high, #1d4ed8);
    outline-offset: 3px;
  }

  @media (max-width: 960px) {
    .hagilight-promoto__slide {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .hagilight-promoto__copy {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }

  @media (max-width: 720px) {
    .hagilight-promoto__shell {
      bottom: calc(env(safe-area-inset-bottom) + 0.5rem);
      width: min(calc(100vw - 1rem), 28rem);
      border-radius: 1rem;
    }

    .hagilight-promoto__slide {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.5rem;
      padding: 0.65rem 3.25rem 0.65rem 0.75rem;
    }

    .hagilight-promoto__copy {
      grid-column: 1;
      grid-row: 1 / 3;
    }

    .hagilight-promoto__title {
      font-size: var(--sl-text-xs);
    }

    .hagilight-promoto__description {
      font-size: var(--sl-text-xs);
      font-weight: 500;
    }

    .hagilight-promoto__image {
      grid-column: 2;
      grid-row: 1;
      width: 3rem;
    }

    .hagilight-promoto__cta {
      grid-column: 2;
      grid-row: 2;
      min-width: 4rem;
      min-height: 1.9rem;
      padding-inline: 0.5rem;
      font-size: var(--sl-text-xs);
      overflow-wrap: anywhere;
    }

    .hagilight-promoto__slide[data-has-image='false'] {
      grid-template-rows: auto;
    }

    .hagilight-promoto__slide[data-has-image='false'] .hagilight-promoto__copy,
    .hagilight-promoto__slide[data-has-image='false'] .hagilight-promoto__cta {
      grid-row: 1;
    }

    .hagilight-promoto__slide[data-has-image='false'] .hagilight-promoto__cta {
      min-width: 4.5rem;
    }

    .hagilight-promoto__controls {
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 0.35rem;
      padding: 0 0.75rem 0.6rem;
    }

    .hagilight-promoto__control {
      min-width: 2rem;
      min-height: 2rem;
      padding-inline: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hagilight-promoto__shell,
    .hagilight-promoto__track {
      transition: none;
    }
  }
</style>
