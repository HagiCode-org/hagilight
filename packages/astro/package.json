{
  "name": "@hagicode/hagilight",
  "version": "0.1.0",
  "type": "module",
  "description": "Astro integrations and components for HagiCode sites",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HagiCode-org/hagilight.git",
    "directory": "packages/astro"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b"
  },
  "exports": {
    "./integration": {
      "types": "./dist/integration.d.ts",
      "default": "./dist/integration.js"
    },
    "./SEOHead": "./SEOHead.astro",
    "./Footer": "./Footer.astro"
  },
  "files": [
    "README.md",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "*.astro",
    "robots.txt.ts",
    "rss*.xml.ts"
  ],
  "peerDependencies": {
    "astro": ">=7"
  },
  "devDependencies": {
    "astro": "^7.3.5"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@hagicode/hagilight-core": "0.1.0"
  },
  "keywords": [
    "hagicode",
    "hagicode-org",
    "hagilight",
    "astro-component",
    "astro-integration",
    "withastro",
    "astro-components",
    "documentation-components",
    "seo"
  ],
  "homepage": "https://github.com/HagiCode-org/hagilight#readme",
  "bugs": {
    "url": "https://github.com/HagiCode-org/hagilight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "HagiCode",
    "url": "https://github.com/HagiCode-org"
  }
}
