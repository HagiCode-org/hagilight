{
  "name": "@hagicode/hagilight",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared Astro components for HagiCode sites",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HagiCode-org/hagilight.git",
    "directory": "packages/astro"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    "./Footer": "./Footer.astro",
    "./Copyright": "./Copyright.astro",
    "./PromotoBanner": "./PromotoBanner.astro",
    "./logo.png": "./logo.png",
    "./favicon.ico": "./favicon.ico",
    "./favicon": "./favicon.mjs",
    "./site-links": "./site-links.ts",
    "./GoogleAnalytics": "./GoogleAnalytics.astro",
    "./Analytics51LA": "./Analytics51LA.astro",
    "./SEOHead": "./SEOHead.astro",
    "./integration": "./integration.mjs",
    "./seo-utils": "./seo-utils.mjs",
    "./rss-locales": "./rss-locales.mjs",
    "./rss": "./rss-renderer.mjs",
    "./seo-schema": {
      "types": "./seo-schema.d.ts",
      "default": "./seo-schema.mjs"
    }
  },
  "files": [
    "*.astro",
    "*.png",
    "*.ico",
    "*.mjs",
    "*.ts",
    "*.json"
  ],
  "peerDependencies": {
    "astro": "^6.0.7 || ^7.3.5"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4"
  },
  "keywords": [
    "astro-component",
    "withastro",
    "astro-components",
    "starlight",
    "documentation-components"
  ]
}