{
  "name": "@hagicode/hagilight-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared TypeScript utilities, components, and assets for HagiCode Astro and Starlight sites",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HagiCode-org/hagilight.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b"
  },
  "exports": {
    "./consent": {
      "types": "./dist/consent.d.ts",
      "default": "./dist/consent.js"
    },
    "./consent-copy": {
      "types": "./dist/consent-copy/index.d.ts",
      "default": "./dist/consent-copy/index.js"
    },
    "./RootTransit": "./RootTransit.astro",
    "./root-transit": {
      "types": "./dist/root-transit.d.ts",
      "default": "./dist/root-transit.js"
    },
    "./root-transit-board": {
      "types": "./dist/root-transit-board.d.ts",
      "default": "./dist/root-transit-board.js"
    },
    "./splash-images": {
      "types": "./dist/splash-images.d.ts",
      "default": "./dist/splash-images.js"
    },
    "./random-image": {
      "types": "./dist/random-image.d.ts",
      "default": "./dist/random-image.js"
    },
    "./footer-avatar": {
      "types": "./dist/footer-avatar.d.ts",
      "default": "./dist/footer-avatar.js"
    },
    "./Footer": "./Footer.astro",
    "./links": {
      "types": "./dist/links.d.ts",
      "default": "./dist/links.js"
    },
    "./favicon": {
      "types": "./dist/favicon.d.ts",
      "default": "./dist/favicon.js"
    },
    "./seo": {
      "types": "./dist/seo.d.ts",
      "default": "./dist/seo.js"
    },
    "./seo-schema": {
      "types": "./dist/seo-schema.d.ts",
      "default": "./dist/seo-schema.js"
    },
    "./og-image": {
      "types": "./dist/og-image.d.ts",
      "default": "./dist/og-image.js"
    },
    "./rss": {
      "types": "./dist/rss.d.ts",
      "default": "./dist/rss.js"
    },
    "./rss-ownership": {
      "types": "./dist/rss-ownership.d.ts",
      "default": "./dist/rss-ownership.js"
    },
    "./site-metadata": {
      "types": "./dist/site-metadata.d.ts",
      "default": "./dist/site-metadata.js"
    },
    "./site-metadata-writer": {
      "types": "./dist/site-metadata-writer.d.ts",
      "default": "./dist/site-metadata-writer.js"
    },
    "./site-metadata-ownership": {
      "types": "./dist/site-metadata-ownership.d.ts",
      "default": "./dist/site-metadata-ownership.js"
    },
    "./promotions": {
      "types": "./dist/promotions.d.ts",
      "default": "./dist/promotions.js"
    },
    "./promoto-banner": {
      "types": "./dist/promoto-banner.d.ts",
      "default": "./dist/promoto-banner.js"
    },
    "./promoto-analytics": {
      "types": "./dist/promoto-analytics.d.ts",
      "default": "./dist/promoto-analytics.js"
    },
    "./analytics-events": {
      "types": "./dist/analytics-events.d.ts",
      "default": "./dist/analytics-events.js"
    },
    "./content-images": {
      "types": "./dist/content-images.d.ts",
      "default": "./dist/content-images.js"
    },
    "./footer-brand": {
      "types": "./dist/footer-brand.d.ts",
      "default": "./dist/footer-brand.js"
    },
    "./build-info": {
      "types": "./dist/build-info.d.ts",
      "default": "./dist/build-info.js"
    },
    "./build-info-resolver": {
      "types": "./dist/build-info-resolver.d.ts",
      "default": "./dist/build-info-resolver.js"
    },
    "./comparison-articles": {
      "types": "./dist/comparison-articles.d.ts",
      "default": "./dist/comparison-articles.js"
    },
    "./comparison-articles-source": {
      "types": "./dist/comparison-articles-source.d.ts",
      "default": "./dist/comparison-articles-source.js"
    },
    "./comparison-articles-data/*.json": "./data/comparison-articles/*.json",
    "./Copyright": "./Copyright.astro",
    "./FooterBrand": "./FooterBrand.astro",
    "./PromotoBanner": "./PromotoBanner.astro",
    "./GoogleAnalytics": "./GoogleAnalytics.astro",
    "./PostHog": "./PostHog.astro",
    "./posthog": {
      "types": "./dist/posthog.d.ts",
      "default": "./dist/posthog.js"
    },
    "./posthog-events": {
      "types": "./dist/posthog-events.d.ts",
      "default": "./dist/posthog-events.js"
    },
    "./Analytics51LA": "./Analytics51LA.astro",
    "./logo.png": "./logo.png",
    "./favicon.ico": "./favicon.ico",
    "./assets/footer/avatar.avif": "./assets/footer/avatar.avif",
    "./assets/footer/avatar.webp": "./assets/footer/avatar.webp",
    "./assets/footer/manifest.json": "./assets/footer/manifest.json"
  },
  "files": [
    "README.md",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json",
    "data/**/*.json",
    "assets/**/*",
    "*.astro",
    "logo.png",
    "favicon.ico"
  ],
  "peerDependencies": {
    "astro": ">=7"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "astro": "^7.3.5"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19"
  },
  "keywords": [
    "hagicode",
    "hagicode-org",
    "hagilight",
    "astro-component",
    "withastro",
    "astro-components",
    "typescript",
    "seo",
    "i18n"
  ],
  "homepage": "https://github.com/HagiCode-org/hagilight#readme",
  "bugs": {
    "url": "https://github.com/HagiCode-org/hagilight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "HagiCode",
    "url": "https://github.com/HagiCode-org"
  }
}
