---
import { CONSENT_DESCRIPTOR_ID, consentDescriptor, renderConsentMarkup, type ConsentPopupOptions } from './dist/consent-markup.js';

interface Props {
  /** The analytics providers this site enables. Mount the popup only when at least one is enabled. */
  providers: ConsentPopupOptions['providers'];
  /** An absolute HTTP(S) URL or a site-relative path. Omitted means the details have no privacy link. */
  privacyUrl?: string;
  /** Defaults to `1`. Changing it asks every visitor again. */
  policyVersion?: string;
  /** The page locale. Defaults to Astro's current locale, then `en-US`. */
  locale?: string;
}

const { providers, privacyUrl, policyVersion, locale = Astro.currentLocale ?? 'en-US' } = Astro.props;
const options: ConsentPopupOptions = { providers, privacyUrl, policyVersion, locale };
const markup = renderConsentMarkup(options);
const descriptor = consentDescriptor(options);
---

<script is:inline type="application/json" id={CONSENT_DESCRIPTOR_ID} set:html={descriptor}></script>
<div class="hagilight-consent-host" set:html={markup}></div>

<script>
  import { mountConsentPopup } from './dist/consent-popup.js';

  mountConsentPopup(document);
</script>

<style is:global>
  /* Tokens follow Starlight's --sl-color-* variables and fall back to light values where a theme omits them. */
  .hagilight-consent {
    --hc-accent: var(--sl-color-accent, #2563eb);
    --hc-bg: var(--sl-color-bg, #ffffff);
    --hc-text: var(--sl-color-text, #1f2937);
    --hc-muted: var(--sl-color-gray-2, color-mix(in srgb, var(--hc-text) 72%, transparent));
    --hc-border: var(--sl-color-gray-5, #cbd5e1);
    --hc-action-bg: var(--sl-color-text-accent, var(--sl-color-accent, #2563eb));
    --hc-action-fg: var(--sl-color-black, #ffffff);
    --hc-focus: var(--sl-color-accent-high, var(--sl-color-accent, #2563eb));
    /* Derived: a surface tinted toward the brand, hairlines from the theme border, motion curves. */
    --hc-surface: color-mix(in srgb, var(--hc-accent) 5%, var(--hc-bg));
    --hc-hairline: color-mix(in srgb, var(--hc-border) 70%, transparent);
    --hc-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --hc-spring: cubic-bezier(0.22, 1, 0.36, 1);

    position: fixed;
    z-index: 45;
    inset-block-end: max(1rem, env(safe-area-inset-bottom, 0px));
    inset-inline-end: max(1rem, env(safe-area-inset-right, 0px));
    box-sizing: border-box;
    width: min(24rem, calc(100vw - 2rem - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)));
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--hc-text) 28%, transparent) transparent;
    padding: 1.25rem 1.25rem 0.5rem;
    border: 0;
    border-radius: 0.875rem;
    background: var(--hc-surface);
    color: var(--hc-text);
    /* Elevation is declared once, as a shadow: a tight contact shadow under a long, soft one. */
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08), 0 18px 44px -14px rgb(0 0 0 / 0.4);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* A damped spring where linear() exists (the same curve as the promotion banner), a long ease-out elsewhere. */
  @supports (animation-timing-function: linear(0, 1)) {
    .hagilight-consent {
      --hc-spring: linear(0, 0.066, 0.22, 0.409, 0.597, 0.761, 0.89, 0.983, 1.042, 1.073, 1.083, 1.079, 1.067, 1.052, 1.036, 1.022, 1.011, 1.002, 0.997, 0.994, 0.993, 0.993, 1);
    }
  }

  /* Below about 36rem the panel attaches to the bottom edge, full width, with its top corners rounded. */
  @media (max-width: 36rem) {
    .hagilight-consent {
      inset-inline: 0;
      inset-block-end: 0;
      width: auto;
      max-width: none;
      max-height: min(85dvh, calc(100dvh - 1rem));
      border-radius: 0.875rem 0.875rem 0 0;
      padding: 1.125rem 1rem max(0.25rem, env(safe-area-inset-bottom, 0px));
      box-shadow: 0 -1px 2px rgb(0 0 0 / 0.06), 0 -14px 36px -14px rgb(0 0 0 / 0.4);
    }
  }

  .hagilight-consent[hidden],
  .hagilight-consent [hidden] {
    display: none;
  }

  /* While the panel fades out its buttons no longer take clicks. */
  .hagilight-consent[data-leaving] {
    pointer-events: none;
  }

  .hagilight-consent ::selection {
    background: color-mix(in srgb, var(--hc-accent) 28%, transparent);
    color: inherit;
  }

  /* The one authored moment: the panel springs up, then its parts settle in order. */
  .hagilight-consent:not([hidden]) {
    animation: hagilight-consent-rise 0.7s var(--hc-spring) backwards;
  }

  .hagilight-consent:not([hidden]) .hagilight-consent__title,
  .hagilight-consent:not([hidden]) .hagilight-consent__intro,
  .hagilight-consent:not([hidden]) .hagilight-consent__actions,
  .hagilight-consent:not([hidden]) .hagilight-consent__toggle {
    animation: hagilight-consent-settle 0.55s var(--hc-ease) backwards;
  }

  .hagilight-consent:not([hidden]) .hagilight-consent__title { animation-delay: 0.1s; }
  .hagilight-consent:not([hidden]) .hagilight-consent__intro { animation-delay: 0.16s; }
  .hagilight-consent:not([hidden]) .hagilight-consent__actions { animation-delay: 0.22s; }
  .hagilight-consent:not([hidden]) .hagilight-consent__toggle { animation-delay: 0.28s; }

  @keyframes hagilight-consent-rise {
    from { opacity: 0; transform: translateY(1.5rem) scale(0.97); }
    to { opacity: 1; transform: none; }
  }

  @keyframes hagilight-consent-settle {
    from { opacity: 0; transform: translateY(0.5rem); }
    to { opacity: 1; transform: none; }
  }

  .hagilight-consent__title {
    margin: 0;
    color: var(--hc-text);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }

  .hagilight-consent__intro {
    margin: 0.375rem 0 0;
    color: var(--hc-muted);
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* The current choice only shows once there is one, as a small status chip beside the actions. */
  .hagilight-consent__choice {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    margin: 0.75rem 0 0;
    padding: 0.1875rem 0.625rem 0.1875rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--hc-text) 7%, transparent);
    color: var(--hc-text);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .hagilight-consent[data-state='undecided'] .hagilight-consent__choice {
    display: none;
  }

  .hagilight-consent__choice::before {
    content: '';
    flex: none;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--hc-muted);
  }

  .hagilight-consent[data-state='granted'] .hagilight-consent__choice::before {
    background: var(--hc-accent);
  }

  .hagilight-consent__actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.5rem;
    margin-top: 1rem;
  }

  /* Accept and Reject share every property, so neither reads as the primary choice. Both rest as a tint and fill on hover. */
  .hagilight-consent__button {
    min-height: 2.75rem;
    margin: 0;
    padding: 0.5rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--hc-action-bg) 55%, transparent);
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--hc-action-bg) 10%, transparent);
    color: var(--hc-text);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
    cursor: pointer;
    transition: background-color 0.18s var(--hc-ease), border-color 0.18s var(--hc-ease), color 0.18s var(--hc-ease), transform 0.18s var(--hc-ease);
  }

  @media (hover: hover) {
    .hagilight-consent__button:hover {
      border-color: var(--hc-action-bg);
      background: var(--hc-action-bg);
      color: var(--hc-action-fg);
    }
  }

  .hagilight-consent__button:active {
    transform: scale(0.98);
  }

  /* A full-width disclosure row: the label on the left, a chevron that turns as the details open. */
  .hagilight-consent__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    box-sizing: border-box;
    width: 100%;
    min-height: 2.5rem;
    margin: 0.75rem 0 0;
    padding: 0.5rem 0;
    border: 0;
    border-top: 1px solid var(--hc-hairline);
    border-radius: 0.25rem;
    background: none;
    color: var(--hc-muted);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    text-align: start;
    cursor: pointer;
    transition: color 0.18s var(--hc-ease);
  }

  .hagilight-consent__toggle::after {
    content: '';
    flex: none;
    width: 0.4375rem;
    height: 0.4375rem;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: translateY(-0.125rem) rotate(45deg);
    transition: transform 0.3s var(--hc-ease);
  }

  .hagilight-consent__toggle[aria-expanded='true']::after {
    transform: translateY(0.125rem) rotate(225deg);
  }

  @media (hover: hover) {
    .hagilight-consent__toggle:hover {
      color: var(--hc-text);
    }
  }

  .hagilight-consent__button:focus-visible,
  .hagilight-consent__toggle:focus-visible,
  .hagilight-consent a:focus-visible {
    outline: 2px solid var(--hc-focus);
    outline-offset: 2px;
  }

  .hagilight-consent__details {
    box-sizing: border-box;
    margin: 0;
    padding: 0 0 0.25rem;
  }

  /* Categories are open sections divided by hairlines, not boxes inside a box. */
  .hagilight-consent__category {
    margin: 0;
    padding: 0.875rem 0;
    border-top: 1px solid var(--hc-hairline);
  }

  .hagilight-consent__category:first-child {
    padding-top: 0.5rem;
    border-top: 0;
  }

  .hagilight-consent__category h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--hc-text);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  /* A filled dot is on, a hollow one is off; the analytics dot follows the visitor's choice. */
  .hagilight-consent__category h3::before {
    content: '';
    flex: none;
    box-sizing: border-box;
    width: 0.5rem;
    height: 0.5rem;
    border: 1.5px solid var(--hc-muted);
    border-radius: 50%;
  }

  .hagilight-consent__category--necessary h3::before,
  .hagilight-consent[data-state='granted'] .hagilight-consent__category--analytics h3::before {
    border-color: var(--hc-accent);
    background: var(--hc-accent);
  }

  .hagilight-consent__category p,
  .hagilight-consent__category ul {
    margin: 0.375rem 0 0;
    padding-inline-start: 1rem;
  }

  .hagilight-consent__category p,
  .hagilight-consent__withdraw {
    color: var(--hc-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .hagilight-consent ul {
    list-style: none;
  }

  /* Storage names are code: monospace, with the kind pushed to the far edge. */
  .hagilight-consent li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    padding: 0.1875rem 0;
    color: var(--hc-muted);
    font-size: 0.75rem;
  }

  .hagilight-consent li span {
    flex: 0 1 auto;
    text-align: end;
  }

  .hagilight-consent code {
    color: var(--hc-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .hagilight-consent__withdraw {
    margin: 0;
    padding: 0.875rem 0 0;
    border-top: 1px solid var(--hc-hairline);
  }

  .hagilight-consent a {
    color: var(--hc-text);
    font-weight: 600;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .hagilight-consent a:hover {
    text-decoration-thickness: 2px;
  }

  .hagilight-consent__privacy {
    margin: 0.5rem 0 0.5rem;
    font-size: 0.8125rem;
  }

  /* Forced colors drop the shadow and the fills, so the panel and the dots get system-colored edges. */
  @media (forced-colors: active) {
    .hagilight-consent {
      border: 1px solid CanvasText;
    }

    .hagilight-consent__button {
      border-color: ButtonText;
    }

    .hagilight-consent__category--necessary h3::before,
    .hagilight-consent[data-state='granted'] .hagilight-consent__category--analytics h3::before {
      border-color: CanvasText;
      background: CanvasText;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hagilight-consent,
    .hagilight-consent * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
