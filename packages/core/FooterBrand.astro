---
import { siteLinkGaAttributes } from './dist/analytics-events.js';
import type { SiteLink } from './dist/links.js';
import { pickFooterBrandLinks, resolveFooterBrand } from './dist/footer-brand.js';

interface Props {
  /** The locale `resolveSiteLinks` returned, so copy and links always agree. */
  locale?: string;
  /** The footer's resolved quick links; the calls to action come from here. */
  links: readonly SiteLink[];
}

const { locale, links } = Astro.props;
const brand = resolveFooterBrand(locale);
const { primary, secondary } = pickFooterBrandLinks(links);
---

<section class="hagilight-brand" lang={brand.locale} aria-labelledby="hagilight-brand-title">
  <div class="hagilight-brand__lead">
    <h2 class="hagilight-brand__headline" id="hagilight-brand-title">{brand.headline}</h2>
    <div class="hagilight-brand__body">
      <p class="hagilight-brand__summary">{brand.summary}</p>
      {(primary || secondary) && (
        <div class="hagilight-brand__actions">
          {primary && (
            <a
              class="hagilight-brand__primary"
              href={primary.href}
              target={primary.target}
              rel={primary.rel}
              aria-label={primary.ariaLabel}
              {...siteLinkGaAttributes(primary, 'footer_brand')}
            >
              <span>{primary.label}</span>
              <svg class="hagilight-brand__arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                <path d="M2.5 8h10M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          )}
          {secondary && (
            <a
              class="hagilight-brand__secondary"
              href={secondary.href}
              target={secondary.target}
              rel={secondary.rel}
              aria-label={secondary.ariaLabel}
              {...siteLinkGaAttributes(secondary, 'footer_brand')}
            >{secondary.label}</a>
          )}
        </div>
      )}
    </div>
  </div>
  <dl class="hagilight-brand__pillars">
    {brand.pillars.map((pillar, index) => (
      <div class="hagilight-brand__pillar" data-pillar={pillar.id} style={`--hagilight-brand-i: ${index}`}>
        <dt>{pillar.label}</dt>
        <dd>{pillar.description}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .hagilight-brand {
    --_heading: var(--sl-color-white, currentColor);
    --_muted: var(--hagilight-footer-muted, var(--sl-color-gray-2, var(--ifm-color-emphasis-700, color-mix(in srgb, currentColor 72%, transparent))));
    --_rule: var(--hagilight-footer-border, var(--sl-color-gray-5, var(--ifm-color-emphasis-300, color-mix(in srgb, currentColor 28%, transparent))));
    container: hagilight-brand / inline-size;
    display: grid;
    gap: 2.25rem;
    margin: 0 auto 2rem;
    max-width: 72rem;
    padding-block: 1rem 2.25rem;
    border-bottom: 1px solid var(--_rule);
  }

  /* Korean breaks between words, not inside them. */
  .hagilight-brand:lang(ko) {
    overflow-wrap: break-word;
    word-break: keep-all;
  }

  .hagilight-brand__lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 3.5rem;
  }

  .hagilight-brand__headline {
    margin: 0;
    color: var(--_heading);
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3rem);
    font-size: clamp(1.75rem, 1rem + 3.2cqi, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .hagilight-brand__headline:lang(zh),
  .hagilight-brand__headline:lang(ja),
  .hagilight-brand__headline:lang(ko) {
    letter-spacing: 0;
    line-height: 1.25;
  }

  .hagilight-brand__body {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    min-width: 0;
  }

  .hagilight-brand__summary {
    margin: 0;
    max-width: 62ch;
    color: var(--_muted);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hagilight-brand__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
  }

  .hagilight-brand__primary,
  .hagilight-brand__secondary {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--_heading);
    text-decoration: none;
  }

  .hagilight-brand__primary {
    gap: 0.6rem;
    border: 2px solid currentColor;
    border-radius: 0.5rem;
    padding-inline: 1.1rem;
    font-weight: 650;
    transition: background-color 180ms ease-out;
  }

  .hagilight-brand__primary:hover {
    background-color: color-mix(in srgb, currentColor 10%, transparent);
  }

  .hagilight-brand__arrow {
    flex: none;
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hagilight-brand__primary:hover .hagilight-brand__arrow,
  .hagilight-brand__primary:focus-visible .hagilight-brand__arrow {
    transform: translateX(0.3rem);
  }

  .hagilight-brand__secondary {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .hagilight-brand__secondary:hover {
    text-decoration-thickness: 2px;
  }

  .hagilight-brand a:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid currentColor;
    outline-offset: 0.25rem;
  }

  .hagilight-brand__pillars {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  .hagilight-brand__pillar {
    position: relative;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--_rule);
  }

  /* The heavy rule that the scroll-driven reveal draws over the hairline track. */
  .hagilight-brand__pillar::before {
    content: '';
    position: absolute;
    inset: -1px 0 auto;
    height: 2px;
    background: var(--_heading);
    transform-origin: left center;
  }

  .hagilight-brand__pillar dt {
    margin: 0 0 0.4rem;
    color: var(--_heading);
    font-size: 1.05rem;
    font-weight: 650;
  }

  .hagilight-brand__pillar dd {
    margin: 0;
    max-width: none;
    color: var(--_muted);
    font-size: 0.9rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* Breakpoints follow the width the footer is given, not the viewport: Starlight's content pane is narrow. */
  @container hagilight-brand (min-width: 40rem) {
    .hagilight-brand__pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem 2.5rem;
    }

    .hagilight-brand__pillar dd {
      max-width: 34ch;
    }
  }

  @container hagilight-brand (min-width: 52rem) {
    .hagilight-brand__lead {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  /*
   * The one authored moment: as the footer scrolls into view the headline is uncovered from
   * its baseline and the three pillar rules draw in left to right, one after another.
   * Without scroll-driven animation, or with reduced motion, everything is simply shown.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .hagilight-brand__headline {
        animation-name: hagilight-brand-uncover;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 80%;
      }

      .hagilight-brand__pillar::before {
        animation-name: hagilight-brand-draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range:
          entry calc(10% + var(--hagilight-brand-i, 0) * 14%)
          entry calc(70% + var(--hagilight-brand-i, 0) * 14%);
      }
    }
  }

  @keyframes hagilight-brand-uncover {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(0.4em);
    }

    to {
      clip-path: inset(0 0 -0.2em 0);
      transform: none;
    }
  }

  @keyframes hagilight-brand-draw {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }
</style>
