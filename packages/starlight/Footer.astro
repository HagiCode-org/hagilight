---
import Copyright from '@hagicode/hagilight-core/Copyright';
import FooterBrand from '@hagicode/hagilight-core/FooterBrand';
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import { siteLinkGaAttributes } from '@hagicode/hagilight-core/analytics-events';
import { resolveSiteLinks, type SiteLinksOptions } from '@hagicode/hagilight-core/links';
import { buildInfoItems, type BuildInfo } from '@hagicode/hagilight-core/build-info';
import { resolveConsentCopy } from '@hagicode/hagilight-core/consent-copy';
import manifest from './package.json';

interface Props {
  locale?: string;
  links?: SiteLinksOptions;
  rssFeedUrl?: string;
  rssLocaleFeedUrls?: Readonly<Record<string, string>>;
  buildInfo?: BuildInfo;
  avatar?: boolean;
  randomAvatar?: boolean;
  /** Adds the "Cookie settings" entry. Set only when the site mounts the consent popup. Defaults to `false`. */
  consent?: boolean;
}

const {
  locale = Astro.locals?.starlightRoute?.locale,
  links,
  rssFeedUrl,
  rssLocaleFeedUrls,
  buildInfo,
  avatar,
  randomAvatar,
  consent = false,
} = Astro.props;
const consentCopy = resolveConsentCopy(locale);
const buildItems = buildInfoItems(buildInfo);
if (typeof manifest.version !== 'string' || manifest.version.trim().length === 0) {
  throw new Error('@hagicode/hagilight-starlight requires a nonempty string version in its package.json.');
}
const currentLanguage = Astro.locals?.starlightRoute?.lang;
const sitemapOverride = links?.overrides?.sitemap;
const resolvedLinks = resolveSiteLinks(currentLanguage ?? locale, {
  ...links,
  overrides: {
    ...links?.overrides,
    sitemap: {
      ...sitemapOverride,
      href: sitemapOverride?.href ?? `${import.meta.env.BASE_URL}sitemap-index.xml`,
    },
  },
  ...(rssFeedUrl === undefined ? {} : { rssFeedUrl }),
  ...(currentLanguage && rssLocaleFeedUrls?.[currentLanguage]
    ? { rssLocaleFeedUrl: rssLocaleFeedUrls[currentLanguage] }
    : {}),
});
---

<DefaultFooter />
<div class="hagilight-brand-host">
  <FooterBrand locale={resolvedLinks.locale} links={resolvedLinks.quick} avatar={avatar} randomAvatar={randomAvatar} siteId={links?.siteId} siteUrl={links?.siteUrl ?? Astro.site?.href} />
</div>
<div class="hagilight-site-links">
  {resolvedLinks.relatedSites.length > 0 && (
    <section>
      <h2>{resolvedLinks.labels.relatedSites}</h2>
      <nav aria-label={resolvedLinks.labels.navigation.relatedSites}>
        <ul>
          {resolvedLinks.relatedSites.map((site) => (
            <li>
              <a href={site.href} target={site.target} rel={site.rel}>
                {site.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>
  )}
  <section>
    <h2>{resolvedLinks.labels.quickLinks}</h2>
    <nav aria-label={resolvedLinks.labels.navigation.quickLinks}>
      <ul>
        {resolvedLinks.quick.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.target}
              rel={link.rel}
              {...siteLinkGaAttributes(link, 'footer')}
            >{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
  <section>
    <h2>{resolvedLinks.labels.community}</h2>
    <nav aria-label={resolvedLinks.labels.navigation.community}>
      <ul>
        {resolvedLinks.community.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.target}
              rel={link.rel}
              {...siteLinkGaAttributes(link, 'footer')}
            >{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
  <nav class="hagilight-filings" aria-label={resolvedLinks.labels.navigation.filings}>
    {resolvedLinks.filings.map((link) => (
      <a
        href={link.href}
        target={link.target}
        rel={link.rel}
        aria-label={link.ariaLabel}
      >{link.label}</a>
    ))}
    {consent && (
      <button type="button" class="hagilight-consent-entry" data-consent-preferences>{consentCopy.footerEntry}</button>
    )}
  </nav>
</div>
<p class="hagilight-copyright">
  <Copyright name="HagiCode" />
  {' | '}
  <span class="hagilight-copyright__attribution">Powered By hagilight-starlight@{manifest.version}</span>
  {buildItems.map((item) => (
    <>
      {' | '}
      <span
        class="hagilight-copyright__build"
        data-build-field={item.field}
        title={item.title}
        data-build-commit={item.title}
      >{item.label}: {item.datetime ? <time datetime={item.datetime}>{item.text}</time> : item.text}</span>
    </>
  ))}
</p>

<style>
  .hagilight-brand-host {
    margin-top: 2rem;
    padding-inline: 1rem;
  }

  .hagilight-site-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem;
    margin: 0 auto 1rem;
    max-width: 72rem;
    padding-inline: 1rem;
    /* Keeps the last links scrollable clear of the consent popup; 0 when no popup is visible. */
    padding-block-end: var(--hagilight-consent-clearance, 0px);
  }

  .hagilight-site-links section {
    min-width: 0;
  }

  .hagilight-site-links h2 {
    margin: 0 0 0.75rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }

  .hagilight-site-links ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hagilight-site-links a {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }

  .hagilight-site-links a:hover {
    color: var(--sl-color-white);
  }

  .hagilight-consent-entry {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .hagilight-filings {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
    padding-top: 1rem;
  }

  .hagilight-copyright {
    margin-block: 1rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    text-align: center;
  }

  .hagilight-copyright__attribution {
    overflow-wrap: anywhere;
  }

  .hagilight-copyright__build {
    overflow-wrap: anywhere;
  }
</style>
