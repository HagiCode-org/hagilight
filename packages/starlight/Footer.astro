---
import Copyright from '@hagicode/hagilight/Copyright';
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import { resolveSiteLinks, type SiteLinksOptions } from '@hagicode/hagilight/site-links';

interface Props {
  locale?: string;
  links?: SiteLinksOptions;
}

const { locale = Astro.locals?.starlightRoute?.locale, links } = Astro.props;
const resolvedLinks = resolveSiteLinks(locale, links);
---

<DefaultFooter />
<nav class="hagilight-site-links" aria-label={resolvedLinks.labels.quickLinks}>
  {resolvedLinks.relatedSites.length > 0 && (
    <section>
      <h2>{resolvedLinks.labels.relatedSites}</h2>
      <ul>
        {resolvedLinks.relatedSites.map((site) => (
          <li><a href={site.href}>{site.name}</a></li>
        ))}
      </ul>
    </section>
  )}
  <section>
    <h2>{resolvedLinks.labels.quickLinks}</h2>
    <ul>
      {resolvedLinks.quick.map((link) => (
        <li><a href={link.href} target={link.target} rel={link.rel}>{link.label}</a></li>
      ))}
    </ul>
  </section>
  <section>
    <h2>{resolvedLinks.labels.community}</h2>
    <ul>
      {resolvedLinks.community.map((link) => (
        <li><a href={link.href} target={link.target} rel={link.rel}>{link.label}</a></li>
      ))}
    </ul>
  </section>
</nav>
<p class="hagilight-copyright"><Copyright name="HagiCode" /></p>

<style>
  .hagilight-site-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem;
    margin: 2rem auto 1rem;
    max-width: 72rem;
    padding-inline: 1rem;
  }

  .hagilight-site-links h2 {
    margin: 0 0 0.75rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }

  .hagilight-site-links ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hagilight-site-links a {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }

  .hagilight-site-links a:hover {
    color: var(--sl-color-white);
  }

  .hagilight-copyright {
    margin-block: 1rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    text-align: center;
  }
</style>
