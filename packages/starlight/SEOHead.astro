---
import { getCollection } from 'astro:content';
import { composeSeoHead, resolveSeoMetadata, serializeJsonLd } from '@hagicode/hagilight-core/seo';
import {
  buildStructuredData,
  createPublishedDocsLookup,
  filterPublishedLocaleAlternates,
  resolveSeoPage,
} from './dist/seo-utils.js';

const { options } = Astro.props;
const route = Astro.locals.starlightRoute;
const routeId = route?.id ?? route?.entry?.id ?? '';
const isNotFound = /(?:^|\/)404(?:\.html)?\/?$/u.test(Astro.url.pathname)
  || routeId === '404'
  || routeId.endsWith('/404');
let head = route?.head ?? [];
let structuredData = [];

if (route?.entry?.collection === 'docs' && !isNotFound && route.entry.data?.draft !== true) {
  const entries = await getCollection('docs', ({ data }) => data.draft !== true);
  const lookup = createPublishedDocsLookup(entries, options.seoLocales);
  const page = resolveSeoPage(routeId, options.seoLocales);
  const sourceEntry = lookup.get(page.route, page.slug);
  const explicitHead = [options.consumerHead, route.entry.data.head];
  head = filterPublishedLocaleAlternates(head, {
    entryId: routeId,
    locales: options.seoLocales,
    lookup,
    basePath: options.seoBasePath,
    explicitHead,
  });

  const seoMetadata = resolveSeoMetadata({
    entry: route.entry,
    head,
    pageSeo: route.entry.data.seo,
    siteSeo: options.seo,
    site: options.seoSite,
    basePath: options.seoBasePath,
    explicitHead,
    body: sourceEntry?.body,
  });
  head = composeSeoHead(head, seoMetadata, explicitHead);
  const canonicalUrl = head.find(({ tag, attrs }) => tag === 'link' && attrs?.rel === 'canonical')?.attrs.href;
  structuredData = buildStructuredData({
    entry: route.entry,
    entryId: routeId,
    canonicalUrl,
    site: options.seoSite,
    siteTitle: route.siteTitle,
    pageSeo: { ...route.entry.data.seo, description: seoMetadata.description },
    organization: options.seo.organization,
    locales: options.seoLocales,
    defaultLocale: options.seoDefaultLocale,
    lookup,
    basePath: options.seoBasePath,
    format: options.seoFormat,
    trailingSlash: options.seoTrailingSlash,
  });
}
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
{structuredData.map((value) => (
  <script type="application/ld+json" set:html={serializeJsonLd(value)} />
))}
