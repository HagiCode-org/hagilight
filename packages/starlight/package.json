{
  "name": "@hagicode/hagilight-starlight",
  "version": "0.2.4",
  "type": "module",
  "description": "Starlight customizations for HagiCode documentation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HagiCode-org/hagilight.git",
    "directory": "packages/starlight"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./locales": {
      "types": "./locales.d.ts",
      "default": "./locales.mjs"
    },
    "./article-promotion-schema": {
      "types": "./article-promotion-schema.d.ts",
      "default": "./article-promotion-schema.mjs"
    },
    "./ai-disclosure-schema": {
      "types": "./ai-disclosure-schema.d.ts",
      "default": "./ai-disclosure-schema.mjs"
    },
    "./rss-schema": {
      "types": "./rss-schema.d.ts",
      "default": "./rss-schema.mjs"
    },
    "./seo-schema": {
      "types": "./seo-schema.d.ts",
      "default": "./seo-schema.mjs"
    },
    "./ContentLayoutToggle": "./ContentLayoutToggle.astro",
    "./Header": "./Header.astro",
    "./Footer": "./Footer.astro",
    "./MarkdownContent": "./MarkdownContent.astro",
    "./ArticlePromotion": "./ArticlePromotion.astro",
    "./PageTitle": "./PageTitle.astro",
    "./NotFoundHero": "./NotFoundHero.astro",
    "./PromotoFooter": "./PromotoFooter.astro"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "*.css",
    "*.mjs",
    "*.d.ts",
    "rss*.xml.ts",
    "*.astro",
    "assets/*.png"
  ],
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@hagicode/hagilight": "0.2.3"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.3.5"
  },
  "keywords": [
    "astro-component",
    "withastro",
    "astro-seo",
    "starlight",
    "multilingual-documentation",
    "hreflang",
    "structured-data"
  ]
}