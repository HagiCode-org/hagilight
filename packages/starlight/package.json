{
  "name": "@hagicode/hagilight-starlight",
  "version": "0.1.0",
  "type": "module",
  "description": "Starlight plugin and components for HagiCode documentation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HagiCode-org/hagilight.git",
    "directory": "packages/starlight"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "default": "./dist/locales.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./showcase": {
      "types": "./dist/showcase.d.ts",
      "default": "./dist/showcase.js"
    },
    "./ContentLayoutToggle": "./ContentLayoutToggle.astro",
    "./ThemeSelect": "./ThemeSelect.astro",
    "./Header": "./Header.astro",
    "./Footer": "./Footer.astro",
    "./MarkdownContent": "./MarkdownContent.astro",
    "./ArticlePromotion": "./ArticlePromotion.astro",
    "./PageTitle": "./PageTitle.astro",
    "./NotFoundHero": "./NotFoundHero.astro",
    "./PromotoFooter": "./PromotoFooter.astro"
  },
  "files": [
    "README.md",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "*.astro",
    "*.css",
    "rss*.xml.ts",
    "assets/showcase/*"
  ],
  "dependencies": {
    "@hagicode/hagilight-core": "0.1.0"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.3.5"
  },
  "keywords": [
    "astro-component",
    "withastro",
    "astro-seo",
    "starlight",
    "starlight-plugin",
    "multilingual-documentation",
    "hreflang",
    "structured-data"
  ]
}
