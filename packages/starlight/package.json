    "./article-promotion-schema": "./article-promotion-schema.mjs",
    "./ai-disclosure-schema": "./ai-disclosure-schema.mjs",
    "./ContentLayoutToggle": "./ContentLayoutToggle.astro",
    "./Header": "./Header.astro",
    "./Footer": "./Footer.astro",
    "./MarkdownContent": "./MarkdownContent.astro",
    "./ArticlePromotion": "./ArticlePromotion.astro",
