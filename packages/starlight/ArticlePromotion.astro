---
import { Image } from 'astro:assets';
import { resolveSiteLinks } from '@hagicode/hagilight-core/links';
import { getArticlePromotionCopy } from './dist/article-promotion.js';
import {
  resolveMicrosoftStoreBadgeLanguage,
  resolveMicrosoftStoreProductId,
} from './dist/windows-download.js';
import heroes from './assets/showcase/heroes.webp';
import pillarEfficient from './assets/showcase/pillar-efficient.svg';
import pillarFun from './assets/showcase/pillar-fun.svg';
import pillarSmart from './assets/showcase/pillar-smart.svg';
import proposalWorkflow from './assets/showcase/proposal-workflow.webp';
import workbench from './assets/showcase/workbench.webp';

const { lang } = Astro.props;
const copy = getArticlePromotionCopy(lang);
const siteLinks = resolveSiteLinks(lang);
const linkHref = (id: string, fallback: string) =>
  [...siteLinks.header, ...siteLinks.quick].find((link) => link.id === id)?.href ?? fallback;
const homeHref = linkHref('home', 'https://www.hagicode.com/');
const docsHref = linkHref('productDocs', 'https://docs.hagicode.com/');
const storeHref = linkHref('microsoftStore', 'https://apps.microsoft.com/detail/9N3PM0N3SVDW');
const downloadsHref = linkHref('downloadClient', 'https://www.hagicode.com/');
const storeProductId = resolveMicrosoftStoreProductId(storeHref);
const badgeLanguage = resolveMicrosoftStoreBadgeLanguage(lang);

// Keyed by the ids in assets/showcase/manifest.json and in the copy catalog's gallery.
const galleryImages: Record<string, ImageMetadata> = {
  workbench,
  'proposal-workflow': proposalWorkflow,
  heroes,
};
const pillarIcons: Record<string, ImageMetadata> = {
  smart: pillarSmart,
  efficient: pillarEfficient,
  fun: pillarFun,
};
const gallery = copy.gallery.flatMap((item) => {
  const image = galleryImages[item.id];
  return image ? [{ ...item, image }] : [];
});
---

<section class="hagilight-article-promotion" aria-labelledby="hagilight-article-promotion-title">
  <div class="hagilight-article-promotion__pitch">
    <div class="hagilight-article-promotion__intro">
      <h2 id="hagilight-article-promotion-title">{copy.title}</h2>
      <p class="hagilight-article-promotion__lead">{copy.lead}</p>
      <p class="hagilight-article-promotion__tagline">{copy.subheadline}</p>
      <div class="hagilight-article-promotion__actions">
        <a class="hagilight-article-promotion__cta hagilight-article-promotion__cta--primary" href={homeHref}>
          {copy.visitLabel}
        </a>
        <a class="hagilight-article-promotion__cta hagilight-article-promotion__cta--secondary" href={docsHref}>
          {copy.docsLabel}
        </a>
      </div>
    </div>

    <ul class="hagilight-article-promotion__features" aria-label={copy.title}>
      {copy.features.map((feature) => (
        <li>
          <span
            class="hagilight-article-promotion__icon"
            aria-hidden="true"
            style={`--hagilight-pillar-icon: url(${pillarIcons[feature.id]?.src})`}
          ></span>
          <strong>{feature.label}</strong>
          <span class="hagilight-article-promotion__feature-text">{feature.description}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="hagilight-article-promotion__gallery-block">
    <h3 id="hagilight-article-promotion-gallery-title">{copy.galleryHeading}</h3>
    <ul class="hagilight-article-promotion__gallery" aria-labelledby="hagilight-article-promotion-gallery-title">
      {gallery.map((item) => (
        <li>
          <figure>
            <Image
              src={item.image}
              alt={item.alt}
              width={item.image.width}
              height={item.image.height}
              widths={[480, 800, item.image.width]}
              sizes="(min-width: 50rem) 560px, 100vw"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            />
            <figcaption>{item.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>

  <div class="hagilight-article-promotion__closing">
    <div class="hagilight-article-promotion__windows">
      <h3 id="hagilight-article-promotion-windows-title" class="hagilight-article-promotion__windows-label">{copy.windowsLabel}</h3>
      <div class="hagilight-article-promotion__windows-actions">
        <ms-store-badge
          productid={storeProductId}
          productname="HagiCode"
          window-mode="direct"
          theme="auto"
          size="large"
          animation="on"
          language={badgeLanguage}
          aria-label={copy.windowsStoreAriaLabel}
          title={copy.windowsStoreAriaLabel}
        >
          <a
            class="hagilight-article-promotion__store-fallback"
            href={storeHref}
            aria-label={copy.windowsStoreAriaLabel}
            title={copy.windowsStoreAriaLabel}
          >{copy.windowsStoreLabel}</a>
        </ms-store-badge>
        <a class="hagilight-article-promotion__downloads" href={downloadsHref}>{copy.allDownloadsLabel}</a>
      </div>
    </div>

    <div class="hagilight-article-promotion__share">
      <h3 id="hagilight-article-promotion-share-title">{copy.shareLabel}</h3>
      <p class="hagilight-article-promotion__share-text">{copy.shareText}</p>
    </div>
  </div>
</section>
<script type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js" is:inline></script>

<style>
  /*
   * Zones, top to bottom: pitch (what it is, where to go, the three pillars), gallery (proof),
   * closing (get it, share it). Zones are separated by space and hairlines rather than nested
   * boxes. The topology follows the section's own width, so the wide-content toggle and the
   * sidebar layouts reflow it, not just the viewport. Mobile-first: the base rules are the
   * single-column layout, which is also what a browser without container queries renders.
   */
  .hagilight-article-promotion {
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    margin: 3rem auto 2rem;
    padding: clamp(1rem, 3vw, 1.75rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--sl-radius-lg, 0.75rem);
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
  }

  .hagilight-article-promotion h2,
  .hagilight-article-promotion h3 {
    margin: 0;
    color: var(--sl-color-white);
    line-height: 1.25;
  }

  .hagilight-article-promotion h2 {
    font-size: var(--sl-text-2xl, 1.5rem);
  }

  .hagilight-article-promotion h3 {
    font-size: var(--sl-text-lg, 1.125rem);
  }

  .hagilight-article-promotion p {
    margin: 0;
    line-height: 1.6;
  }

  .hagilight-article-promotion ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hagilight-article-promotion a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }

  /* Pitch: headline, definition, promise, then the way in. */
  .hagilight-article-promotion__pitch {
    display: grid;
    gap: 1.75rem;
  }

  .hagilight-article-promotion__intro {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
  }

  .hagilight-article-promotion__lead,
  .hagilight-article-promotion__tagline {
    max-inline-size: 68ch;
  }

  .hagilight-article-promotion__tagline {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .hagilight-article-promotion__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }

  .hagilight-article-promotion__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--sl-color-text-accent);
    border-radius: var(--sl-radius-sm, 0.375rem);
    font-weight: 700;
    text-decoration: none;
  }

  .hagilight-article-promotion__cta--primary {
    background: var(--sl-color-text-accent);
    color: var(--sl-color-bg);
  }

  .hagilight-article-promotion__cta--secondary {
    background: transparent;
    color: var(--sl-color-text-accent);
  }

  .hagilight-article-promotion__cta:hover {
    filter: brightness(1.08);
  }

  /* Pillars: one hairline-topped row each, icon and word on a line, description under it. */
  .hagilight-article-promotion__features {
    display: grid;
    gap: 1rem 1.5rem;
  }

  .hagilight-article-promotion__features li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    align-items: center;
    gap: 0.5rem 0.625rem;
    min-width: 0;
    padding-block-start: 0.875rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
  }

  .hagilight-article-promotion__features strong {
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-lg, 1.125rem);
    line-height: 1.25;
  }

  .hagilight-article-promotion__feature-text {
    grid-column: 1 / -1;
    font-size: var(--sl-text-sm, 0.875rem);
    line-height: 1.55;
  }

  .hagilight-article-promotion__icon {
    width: 1.5rem;
    height: 1.5rem;
    background: var(--sl-color-text-accent);
    mask: var(--hagilight-pillar-icon) center / contain no-repeat;
    -webkit-mask: var(--hagilight-pillar-icon) center / contain no-repeat;
  }

  /* Gallery: three audited screenshots, kept in the catalog's narrative order. */
  .hagilight-article-promotion__gallery-block {
    display: grid;
    gap: 1rem;
  }

  .hagilight-article-promotion__gallery {
    display: grid;
    gap: 1.25rem 1rem;
  }

  .hagilight-article-promotion__gallery li {
    min-width: 0;
  }

  .hagilight-article-promotion figure {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .hagilight-article-promotion img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--sl-radius-md, 0.5rem);
  }

  .hagilight-article-promotion figcaption {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm, 0.875rem);
    line-height: 1.5;
  }

  /* Closing: the practical next steps, as two parallel headed blocks. */
  .hagilight-article-promotion__closing {
    display: grid;
    gap: 1.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
  }

  .hagilight-article-promotion__windows,
  .hagilight-article-promotion__share {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.5rem;
    min-width: 0;
  }

  /* Reserve the large badge's height (104px) so it replaces the fallback link without a layout jump. */
  .hagilight-article-promotion__windows-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.25rem;
    max-width: 100%;
  }

  .hagilight-article-promotion__windows ms-store-badge {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    min-height: 6.5rem;
  }

  /* Keep the badge's fixed height and shrink it to the slot on narrow screens without distortion. */
  .hagilight-article-promotion__windows ms-store-badge::part(img) {
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  .hagilight-article-promotion__store-fallback,
  .hagilight-article-promotion__downloads {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  .hagilight-article-promotion__share-text {
    justify-self: stretch;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: var(--sl-radius-md, 0.5rem);
    background: var(--sl-color-bg);
    overflow-wrap: anywhere;
    user-select: all;
  }

  /* Medium: pillars become a three-up row, the gallery a mosaic, the closing two columns. */
  @container (min-width: 36rem) {
    .hagilight-article-promotion__features {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /*
     * Mosaic in reading order: the workbench and the proposal strip stack in the left column
     * beside the tall Hero Dungeon panel. The 1.1fr split lands the image bottoms of both columns within
     * a caption's height of each other for the current screenshots; the placement assumes exactly
     * three gallery images.
     */
    .hagilight-article-promotion__gallery {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
    }

    .hagilight-article-promotion__gallery li:nth-child(1) {
      grid-column: 1;
      grid-row: 1;
    }

    .hagilight-article-promotion__gallery li:nth-child(2) {
      grid-column: 1;
      grid-row: 2;
    }

    .hagilight-article-promotion__gallery li:nth-child(3) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .hagilight-article-promotion__closing {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  /* Wide: the pitch takes the left column and the pillars stack beside it. */
  @container (min-width: 56rem) {
    .hagilight-article-promotion__pitch {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }

    .hagilight-article-promotion__features {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 30rem) {
    .hagilight-article-promotion__actions {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      justify-self: stretch;
    }
  }
</style>
