---
import heroImage from './assets/light-main.png';
import { getArticlePromotionCopy } from './article-promotion.mjs';

const { lang } = Astro.props;
const copy = getArticlePromotionCopy(lang);
---

<section class="hagilight-article-promotion" aria-labelledby="hagilight-article-promotion-title">
  <div>
    <h2 id="hagilight-article-promotion-title">{copy.title}</h2>
    <p>{copy.lead}</p>
    <p>{copy.subheadline}</p>
  </div>
  <img
    src={heroImage.src}
    alt={copy.imageAlt}
    width={heroImage.width}
    height={heroImage.height}
    loading="lazy"
    decoding="async"
  />
  <ul aria-label={copy.title}>
    {copy.features.map((feature) => (
      <li>
        <strong>{feature.label}</strong>
        <span>{feature.description}</span>
      </li>
    ))}
  </ul>
  <a href="https://www.hagicode.com/">{copy.visitLabel}</a>
</section>

<style>
  .hagilight-article-promotion {
    display: grid;
    gap: 1rem;
    margin: 2rem auto;
    padding: clamp(1rem, 3vw, 1.75rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
  }

  .hagilight-article-promotion h2 {
    margin: 0;
  }

  .hagilight-article-promotion p {
    margin: 0.5rem 0;
    line-height: 1.6;
  }

  .hagilight-article-promotion img {
    width: 100%;
    height: auto;
    border-radius: var(--sl-radius-md);
  }

  .hagilight-article-promotion ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .hagilight-article-promotion li {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--sl-radius-md);
  }

  .hagilight-article-promotion li strong {
    color: var(--sl-color-text-accent);
  }

  .hagilight-article-promotion > a {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border-radius: var(--sl-radius-sm);
    background: var(--sl-color-text-accent);
    color: var(--sl-color-bg);
    font-weight: 700;
    text-decoration: none;
  }

  .hagilight-article-promotion > a:hover {
    filter: brightness(1.08);
  }

  .hagilight-article-promotion > a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }

  @media (max-width: 30rem) {
    .hagilight-article-promotion ul {
      grid-template-columns: 1fr;
    }
  }
</style>
