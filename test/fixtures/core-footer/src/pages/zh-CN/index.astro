---
import SEOHead from '@hagicode/hagilight/SEOHead';
import Footer from '@hagicode/hagilight/Footer';

const site = Astro.site?.href;
if (!site) throw new Error('The installed core fixture requires an absolute Astro site URL.');
const pageUrl = new URL(Astro.url.pathname, site).href;
const links = {
  relatedSites: [{
    id: 'consumer-site',
    name: { 'zh-CN': '自有站点' },
    url: 'https://sites.example/',
  }],
  overrides: {
    blog: { href: '/news/', label: { 'zh-CN': '新闻' } },
  },
  rssFeedUrl: 'https://feeds.example/rss.xml',
  extraLinks: {
    quick: [{ id: 'install', href: '/install/', label: { 'zh-CN': '安装' } }],
    community: [{
      id: 'community-chat',
      href: 'https://community.example/',
      label: { 'zh-CN': '社区聊天' },
      external: true,
    }],
  },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <link rel="alternate" type="application/rss+xml" href={`${import.meta.env.BASE_URL}rss.xml`} />
    <SEOHead site={site} page={{ url: pageUrl, title: '已安装 core SEO', description: '独立 core 元数据。' }} />
  </head>
  <body><Footer links={links} /></body>
</html>
